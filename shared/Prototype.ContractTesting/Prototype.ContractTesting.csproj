<Project Sdk="Microsoft.NET.Sdk">

  <!-- Helpers for the *.ContractTests projects: start a service, start dependency mocks,
       run Specmatic (Docker) against the contract. No NuGet packages. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
