# Build output
bin/
obj/
.vs/
node_modules/

# Logs and runtime state
*.log
results/service-pids.json

# Separate git repository (central contract repo)
contracts/

# Very large raw output of the uncapped resiliency run (an excerpt is committed instead)
results/case1/04-resiliency/console.txt
results/case1/04-resiliency/junit/

# Specmatic's clone of the contract repo when a config uses a git source
.specmatic/

# Evidence runs (scripts/run-evidence.ps1): local only. evidence/sample/ is the one committed snapshot.
evidence/history/
evidence/latest/

# Default output of a local `dotnet test` of the ContractTests (pipeline runs write to results/pipeline/<run>/)
results/pipeline/contract-tests/

# Test-run files with machine/user details (TRX contains DOMAIN\user and local paths)
results/pipeline/**/*.trx

# Playwright HTML report embeds compressed run data (may contain local paths): keep it local only
results/**/playwright-report/
