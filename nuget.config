<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-local NuGet sources: public nuget.org only. <clear/> ignores any machine-wide or
     company feeds, so restores are reproducible on any machine and in CI. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
