{
  "openapi": "3.0.3",
  "info": {
    "title": "Well Registry API",
    "version": "1.0.0",
    "description": "App A (Production). Manages wells: list, get by id, create. Provider: well-registry-service. Consumers: production-forecast-service (C1).\n"
  },
  "servers": [
    {
      "url": "/v2",
      "description": "Base path of every business endpoint. Note: Specmatic ignores the servers path; tests pass it via --testBaseURL (e.g. http://localhost:5101/v2).\n"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "wells"
    }
  ],
  "paths": {
    "/wells": {
      "get": {
        "tags": [
          "wells"
        ],
        "operationId": "listWells",
        "summary": "List wells, optionally filtered by status.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/WellStatus"
            },
            "examples": {
              "LIST_ACTIVE": {
                "value": "ACTIVE"
              },
              "LIST_SHUT_IN": {
                "value": "SHUT_IN"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Wells matching the filter (may be empty).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Well"
                  }
                },
                "examples": {
                  "LIST_ACTIVE": {
                    "value": [
                      {
                        "id": "W-001",
                        "name": "Eagle-1",
                        "field": "Eagle Ford",
                        "status": "ACTIVE",
                        "latitude": 28.5,
                        "longitude": -98.3,
                        "spudDate": "2019-04-12",
                        "dailyCapacityBbl": 1200
                      },
                      {
                        "id": "W-002",
                        "name": "Eagle-2",
                        "field": "Eagle Ford",
                        "status": "ACTIVE",
                        "latitude": 28.6,
                        "longitude": -98.2,
                        "spudDate": "2020-08-01",
                        "dailyCapacityBbl": 800
                      }
                    ]
                  },
                  "LIST_SHUT_IN": {
                    "value": [
                      {
                        "id": "W-003",
                        "name": "Permian-7",
                        "field": "Permian Basin",
                        "status": "SHUT_IN",
                        "latitude": 31.9,
                        "longitude": -102.1,
                        "spudDate": "2015-02-20",
                        "dailyCapacityBbl": 0
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "wells"
        ],
        "operationId": "createWell",
        "summary": "Register a new well.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWellRequest"
              },
              "examples": {
                "CREATE_EAGLE_9": {
                  "value": {
                    "name": "Eagle-9",
                    "field": "Eagle Ford",
                    "status": "ACTIVE",
                    "latitude": 28.7,
                    "longitude": -98.1,
                    "spudDate": "2024-05-01",
                    "dailyCapacityBbl": 650,
                    "operator": "Ops-Team-1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "headers": {
              "Location": {
                "required": true,
                "description": "URL of the new well.",
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "CREATE_EAGLE_9": {
                    "value": "/v2/wells/W-004"
                  }
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Well"
                },
                "examples": {
                  "CREATE_EAGLE_9": {
                    "value": {
                      "id": "W-004",
                      "name": "Eagle-9",
                      "field": "Eagle Ford",
                      "status": "ACTIVE",
                      "latitude": 28.7,
                      "longitude": -98.1,
                      "spudDate": "2024-05-01",
                      "dailyCapacityBbl": 650
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/wells/{wellId}": {
      "get": {
        "tags": [
          "wells"
        ],
        "operationId": "getWell",
        "summary": "Get one well by id.",
        "parameters": [
          {
            "name": "wellId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/WellId"
            },
            "examples": {
              "GET_W001": {
                "value": "W-001"
              },
              "UNKNOWN_WELL": {
                "value": "W-999"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The well.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Well"
                },
                "examples": {
                  "GET_W001": {
                    "value": {
                      "id": "W-001",
                      "name": "Eagle-1",
                      "field": "Eagle Ford",
                      "status": "ACTIVE",
                      "latitude": 28.5,
                      "longitude": -98.3,
                      "spudDate": "2019-04-12",
                      "dailyCapacityBbl": 1200
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "The well does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                "examples": {
                  "UNKNOWN_WELL": {
                    "value": {
                      "type": "https://tools.ietf.org/html/rfc9110#section-15.5.5",
                      "title": "Not Found",
                      "status": 404,
                      "detail": "Well W-999 does not exist."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "OAuth2 access token in production; a fixed test token in this prototype."
      }
    },
    "schemas": {
      "WellId": {
        "type": "string",
        "pattern": "^W-\\d{3}$",
        "example": "W-001"
      },
      "WellStatus": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "SHUT_IN",
          "ABANDONED"
        ]
      },
      "Well": {
        "type": "object",
        "required": [
          "id",
          "name",
          "field",
          "status",
          "latitude",
          "longitude",
          "spudDate",
          "dailyCapacityBbl"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/WellId"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Oil field the well belongs to."
          },
          "status": {
            "$ref": "#/components/schemas/WellStatus"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "spudDate": {
            "type": "string",
            "format": "date",
            "description": "Date drilling started."
          },
          "dailyCapacityBbl": {
            "type": "number",
            "minimum": 0,
            "description": "Nameplate capacity in barrels per day."
          }
        }
      },
      "CreateWellRequest": {
        "type": "object",
        "required": [
          "name",
          "field",
          "status",
          "latitude",
          "longitude",
          "spudDate",
          "dailyCapacityBbl",
          "operator"
        ],
        "properties": {
          "operator": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "status": {
            "$ref": "#/components/schemas/WellStatus"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "spudDate": {
            "type": "string",
            "format": "date"
          },
          "dailyCapacityBbl": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "description": "RFC 9457 problem details. `errors` is only present for field validation failures; a malformed body (e.g. a string where a number is expected) returns a ProblemDetails without `errors`.\n",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "description": "Field name -> list of messages.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation failed or the request was malformed.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid bearer token.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    }
  }
}
